[Unit]
Description=Turing AI Assistant (OpenClaw Gateway)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
WorkingDirectory=/home/jtbaccus/turing/projects/openclaw-custom
EnvironmentFile=-/home/jtbaccus/.openclaw/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/run-node.mjs gateway
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=turing

[Install]
WantedBy=default.target
