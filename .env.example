# OpenClaw Custom Fork — Required Environment Variables
#
# Quick start:
# 1) Copy this file to `.env` (for local runs) OR to `~/.openclaw/.env` (for systemd daemon)
# 2) Fill in your values
# 3) Keep real secrets out of git
#
# Env-source precedence (highest -> lowest):
# process env, ./.env, ~/.openclaw/.env, then openclaw.json `env` block

# -----------------------------------------------------------------------------
# Gateway auth
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Example generator: openssl rand -hex 32

# -----------------------------------------------------------------------------
# Model provider API keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...          # For embeddings (text-embedding-3-small)

# Ollama (local, no key needed — just ensure service is running)
# systemctl start ollama
# ollama pull qwen3:30b

# -----------------------------------------------------------------------------
# Channels
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC...    # From @BotFather
TELEGRAM_ALLOWED_USER_ID=123456789  # Your Telegram user ID (get from @userinfobot)

DISCORD_BOT_TOKEN=...               # From Discord Developer Portal
DISCORD_APP_ID=...                  # Application ID from Discord Developer Portal
